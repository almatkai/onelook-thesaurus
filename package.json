{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "onelook-thesaurus",
  "title": "OneLook Thesaurus",
  "description": "A powerful English thesaurus and brainstorming tool that lets you describe what you're looking for in plain terms.",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search",
      "title": "Search",
      "description": "Enter a word, phrase, description, or pattern above to find synonyms, related words, and more.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.onelook-thesaurus",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/onelook-thesaurus",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/onelook-thesaurus",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
